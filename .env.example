# Copia este archivo como ".env" y ajusta los valores.
# ".env" ya está en .gitignore: nunca se sube al repositorio.

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eyecare

# --- Autenticación ---
# Cadena larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-este-valor-por-uno-propio-y-largo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# --- n8n (diagnóstico narrativo, opcional en esta etapa) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/visual-fatigue-diagnosis
